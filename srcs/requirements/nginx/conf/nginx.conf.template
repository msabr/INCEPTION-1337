events {}
# NGINX requires this block to exist, even empty, for connection settings.

http {
    include mime.types;
    # Tells the browser "this is a .css file", "this is a .js file", etc.

    server {
        listen 443 ssl;
        # Only listen on 443, and only accept HTTPS — this is what makes
        # plain http:// requests fail, which the grading checklist tests for.

        server_name ${DOMAIN_NAME};
        # ${DOMAIN_NAME} gets replaced with msabr.42.fr at container startup.

        ssl_certificate     /etc/nginx/ssl/nginx.crt;
        ssl_certificate_key /etc/nginx/ssl/nginx.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        # Required: only these two TLS versions are allowed, nothing older.

        root  /var/www/html;
        # WordPress's files live here (shared with the wordpress container).
        index index.php;

        location / {
            try_files $uri $uri/ /index.php?$args;
            # If the requested file doesn't exist, hand off to WordPress's
            # own router (index.php) instead of returning a 404.
        }

        location ~ \.php$ {
            fastcgi_pass wordpress:9000;
            # Forward all .php requests to the wordpress container, port 9000
            # (its container name doubles as its hostname on our network).
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        }
    }
}
