DOMAIN_NAME=msabr.42.fr
LOGIN=msabr

# --- MariaDB ---
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password
MYSQL_PASSWORD_FILE=/run/secrets/db_password

# --- WordPress / DB connection ---
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD_FILE=/run/secrets/db_password
WORDPRESS_TABLE_PREFIX=wp_

# --- WordPress site / users ---
# NOTE: WP_ADMIN_USER must NOT contain "admin" (checked during defense).
WP_TITLE=Inception
WP_ADMIN_USER=superuser
WP_ADMIN_PASSWORD_FILE=/run/secrets/wp_admin_password
WP_ADMIN_EMAIL=superuser@example.com
WP_USER=editor
WP_USER_PASSWORD_FILE=/run/secrets/wp_user_password
WP_USER_EMAIL=editor@example.com
